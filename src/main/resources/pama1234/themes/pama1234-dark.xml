<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE RSyntaxTheme SYSTEM "theme.dtd">
<!--
	Pama1234 Dark Theme for RSyntaxTextArea
	Based on pama1234-dark v2.03 IDEA theme
	See theme.dtd and org.fife.ui.rsyntaxtextarea.Theme for more information.
-->
<RSyntaxTheme version="1.0">
  <!-- Omitting baseFont will use a system-appropriate monospaced. -->
  <!--<baseFont family="..." size="13"/>-->

  <!--  General editor colors based on pama1234 dark theme. -->
  <background color="1E1E1E" />
  <caret color="D4D4D4" />
  <selection useFG="false" bg="745C00" roundedEdges="false" />
  <currentLineHighlight color="152D30" fade="false" />
  <marginLine fg="394448" />
  <markAllHighlight color="6B8189" />
  <markOccurrencesHighlight color="3C3C57" border="false" />
  <matchedBracket fg="D4D4D4" bg="3A6DA0" highlightBoth="false" animate="true" />
  <hyperlinks fg="C7C7FF" />
  <secondaryLanguages>
    <language index="1" bg="273627" />
    <language index="2" bg="30322B" />
    <language index="3" bg="3F484C" />
  </secondaryLanguages>

  <!-- Gutter styling. -->
  <gutterBorder color="394448" />
  <lineNumbers fg="D4D4D4" currentFG="D4D4D4"/>
  <foldIndicator fg="6A8088" armedFg="D4D4D4" iconBg="1E1E1E" iconArmedBg="152D30" />
  <iconRowHeader activeLineRange="3399FF" />

  <!-- Syntax tokens based on pama1234 dark theme colors. -->
  <tokenStyles>
    <style token="IDENTIFIER" fg="D4D4D4" />
    <style token="RESERVED_WORD" fg="1AACA1" bold="true" />
    <style token="RESERVED_WORD_2" fg="1AACA1" bold="true" />
    <style token="ANNOTATION" fg="D4D4D4" />
    <style token="COMMENT_DOCUMENTATION" fg="32A6CC" italic="true" />
    <style token="COMMENT_EOL" fg="7EB361" italic="true" />
    <style token="COMMENT_MULTILINE" fg="7EB361" italic="true" />
    <style token="COMMENT_KEYWORD" fg="7EB361" bold="true" />
    <style token="COMMENT_MARKUP" fg="7EB361" />
    <style token="FUNCTION" fg="32A6CC" />
    <style token="DATA_TYPE" fg="9983F1" bold="true" />
    <style token="LITERAL_BOOLEAN" fg="1AACA1" bold="true" />
    <style token="LITERAL_NUMBER_DECIMAL_INT" fg="4A40FF" />
    <style token="LITERAL_NUMBER_FLOAT" fg="4A40FF" />
    <style token="LITERAL_NUMBER_HEXADECIMAL" fg="4A40FF" />
    <style token="LITERAL_STRING_DOUBLE_QUOTE" fg="C96BDA" />
    <style token="LITERAL_CHAR" fg="C96BDA" />
    <style token="LITERAL_BACKQUOTE" fg="C96BDA" />
    <style token="MARKUP_TAG_DELIMITER" fg="D4D4D4" />
    <style token="MARKUP_TAG_NAME" fg="FB6104" bold="true" />
    <style token="MARKUP_TAG_ATTRIBUTE" fg="D53569" />
    <style token="MARKUP_TAG_ATTRIBUTE_VALUE" fg="C96BDA" bold="true" />
    <style token="MARKUP_COMMENT" fg="7EB361" italic="true" />
    <style token="MARKUP_DTD" fg="FB6104" />
    <style token="MARKUP_PROCESSING_INSTRUCTION" fg="FB6104" />
    <style token="MARKUP_CDATA" fg="C96BDA" />
    <style token="MARKUP_CDATA_DELIMITER" fg="D4D4D4" />
    <style token="MARKUP_ENTITY_REFERENCE" fg="C7C7FF" bold="true" />
    <style token="OPERATOR" fg="D4D4D4" />
    <style token="PREPROCESSOR" fg="1AACA1" bold="true" />
    <style token="REGEX" fg="C96BDA" />
    <style token="SEPARATOR" fg="D4D4D4" />
    <style token="VARIABLE" fg="E96DB4" bold="true" />
    <style token="WHITESPACE" fg="D4D4D4" />
    <style token="ERROR_IDENTIFIER" fg="D4D4D4" bg="6E3B3B" />
    <style token="ERROR_NUMBER_FORMAT" fg="D4D4D4" bg="6E3B3B" />
    <style token="ERROR_STRING_DOUBLE" fg="D4D4D4" bg="6E3B3B" />
    <style token="ERROR_CHAR" fg="D4D4D4" bg="6E3B3B" />
  </tokenStyles>
</RSyntaxTheme>